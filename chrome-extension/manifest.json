{
  "manifest_version": 3,
  "name": "717study.com 打字机",
  "version": "0.5.1",
  "description": "在用户主动选择的网页输入框中按可配置节奏输入本地文本或 DOCX 内容。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "debugger"],
  "host_permissions": ["https://www.717study.com/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "717study.com 打字机",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
